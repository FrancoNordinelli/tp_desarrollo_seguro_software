              "mode": "raw",
              "raw": "{\n  \"email\": \"nuevo@test.com\",\n  \"nombre\": \"Nuevo\",\n  \"apellido\": \"Usuario\",\n  \"telefono\": null,\n  \"password\": \"Museo#2026ok\"\n}",
