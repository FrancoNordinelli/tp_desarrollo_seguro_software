                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"visitante@test.com\",\n  \"password\": \"{{clave}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda el token en la variable de la colección para las demás peticiones.",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', pm.response.json().accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
