        },
        {
          "name": "Reporte de asistencia (GraphQL)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Reporte($filtro: FiltroReporte) {\n  reporteAsistencia(filtro: $filtro) {\n    fechaCorte\n    grupos {\n      mes\n      tipo\n      cantidadDeEventos\n      totalInscriptosAcumulados\n      promedioDeAsistencia\n      eventosMasPopulares { id titulo cantidadInscriptos }\n    }\n  }\n}",
                "variables": "{\n  \"filtro\": {\n    \"estado\": \"TODOS\",\n    \"agruparPor\": \"MES_Y_TIPO\"\n  }\n}"
              }
            }
          }
        }
      ]
    },
    {
      "name": "Catálogo (GraphQL)",
      "item": [
        {
          "name": "Obras con filtros combinados",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Obras($filtro: FiltroObras) {\n  obras(filtro: $filtro) {\n    id\n    titulo\n    artista { nombre }\n    epoca\n    enExhibicion\n  }\n}",
                "variables": "{\n  \"filtro\": {\n    \"epoca\": \"Renacimiento\",\n    \"enExhibicion\": true\n  }\n}"
              }
            }
          }
        },
        {
          "name": "Una obra con todo anidado",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Obra($id: ID!) {\n  obra(id: $id) {\n    titulo\n    artista { nombre biografia }\n    imagenUrl anioCreacion tecnica dimensiones epoca descripcion ubicacion enExhibicion\n    comentarios { usuario texto fecha }\n  }\n}",
                "variables": "{\n  \"id\": \"1\"\n}"
              }
            }
          }
        }
